# Copy to .env; start.sh loads this file as shell configuration.
HOST=127.0.0.1
PORT=8000
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
SHELLGPT_API_KEY=replace-with-a-random-local-key

# Authenticate with `claude auth login`, or uncomment ONE credential below.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# Do not point ANTHROPIC_BASE_URL at this bridge.

# Claude Code -> provider gateway (separate from the port-8000 text bridge)
GATEWAY_PORT=8001
GATEWAY_TIMEOUT=180
CODEX_MODEL=gpt-6-astra
ANTIGRAVITY_MODEL=gemini-3.8-flash-low
ANTHROPIC_MODEL=claude-sonnet-5-5

# ShellGPT Universal Provider Gateway & Custom API Controller (MODE A)
# Asemprotic configurable custom provider (do not assume default endpoint)
# ASEMPROTIC_API_KEY=
# ASEMPROTIC_BASE_URL=
# ASEMPROTIC_MODEL=
# ASEMPROTIC_API_FORMAT=openai

# Optional cloud/local provider credentials
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
